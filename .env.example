# ---------------------------------------------------------------------------
# 站点环境变量：复制为 .env 后按实际值修改
#   cp .env.example .env
#
# 注意：.env 含密钥，已在 .gitignore 中排除，切勿提交到 git。
# ---------------------------------------------------------------------------

# 访问地址（不带结尾斜杠）。目前用 IP，有域名后改成 https://your-domain.com
SITE_URL=http://47.238.215.116

# 域名（用于证书申请，暂时不用）
DOMAIN=47.238.215.116

# 站点名称
SITE_NAME=DevLog

# 证书到期提醒邮箱
ACME_EMAIL=you@example.com

# 时区
TZ=Asia/Shanghai